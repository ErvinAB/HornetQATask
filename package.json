{
  "name": "hornet-todo-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Hornetsecurity Senior QA Automation Engineer assessment — TodoMVC Playwright suite",
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:known-issue": "npx playwright test --grep @known-issue",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "server": "node scripts/server.cjs",
    "serve": "node scripts/server.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^26.1.2",
    "allure-commandline": "2.32.0",
    "allure-playwright": "3.10.2",
    "typescript": "5.7.3"
  }
}
